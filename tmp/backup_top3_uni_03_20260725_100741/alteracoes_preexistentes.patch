+/* TPP01_ABLATION_SUPPORT_START */
+function getTop3AblationVariant() {
+  if (
+    typeof global === "undefined" ||
+    !global.__TOP3_ABLATION__
+  ) {
+    return "A00";
+  }
+
+  return String(
+    global.__TOP3_ABLATION__
+  )
+    .trim()
+    .toUpperCase();
+}
+
+function resolveScoreConfigForAblation() {
+  const variant =
+    getTop3AblationVariant();
+
+  if (
+    variant === "A00" ||
+    variant === "BASELINE" ||
+    variant === "BASELINE_COMPLETO"
+  ) {
+    return scoreConfig;
+  }
+
+  const evidenceModules = {
+    ...(scoreConfig?.evidenceModules || {}),
+  };
+
+  for (
+    const [name, config]
+    of Object.entries(evidenceModules)
+  ) {
+    evidenceModules[name] = {
+      ...(config || {}),
+    };
+  }
+
+  if (
+    variant === "A01" ||
+    variant === "SEM_FREQUENCY"
+  ) {
+    evidenceModules.frequency = {
+      ...(evidenceModules.frequency || {}),
+      enabled: false,
+    };
+  } else if (
+    variant === "A02" ||
+    variant === "SEM_CONTEXT"
+  ) {
+    evidenceModules.context = {
+      ...(evidenceModules.context || {}),
+      enabled: false,
+    };
+  } else {
+    throw new Error(
+      `Variante de abla├º├úo desconhecida: ${variant}`
+    );
+  }
+
+  return {
+    ...scoreConfig,
+    evidenceModules,
+  };
+}
+/* TPP01_ABLATION_SUPPORT_END */
+
