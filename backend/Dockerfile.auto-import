FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production
ENV TZ=America/Sao_Paulo

# TOP3_AUTO_IMPORT_RUNTIME_PACKAGE_V1
#
# Este Dockerfile deve ser construído usando a raiz do repositório:
# docker build -f backend/Dockerfile.auto-import .

COPY backend/package.json backend/package-lock.json ./

RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force

COPY --chown=node:node backend/ /app/

COPY --chown=node:node \
    src/pages/Top3/ \
    /src/pages/Top3/

COPY --chown=node:node \
    src/shared/predictiveMilharEngine/ \
    /src/shared/predictiveMilharEngine/

COPY --chown=node:node \
    src/pages/Centenas/modules/ \
    /src/pages/Centenas/modules/

RUN test -f /src/pages/Top3/top3.public-api.js \
    && test -f /src/pages/Top3/top3.engine.js \
    && test -d /src/shared/predictiveMilharEngine \
    && test -d /src/pages/Centenas/modules \
    && node --check /app/scripts/importKingApostas.js \
    && node --check /app/engine/scoreEngineUnified.js \
    && mkdir -p /app/logs \
    && chown -R node:node /app/logs /src

USER node

CMD ["node", "scripts/runAutoImportHeartbeat.js"]
