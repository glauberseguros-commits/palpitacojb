{
  "version": 2,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "build",
  "routes": [
    {
      "src": "^/$",
      "dest": "/gateway.html"
    },

    {
      "src": "^/loterias/?$",
      "dest": "https://palpitaco-loterias-app.web.app/?release=94f5141"
    },
    {
      "src": "^/loterias/(.*)$",
      "dest": "https://palpitaco-loterias-app.web.app/$1?release=94f5141"
    },

    {
      "src": "^/palpitacomilharprime/?$",
      "dest": "/palpitacomilharprime/index.html"
    },

    {
      "src": "^/health$",
      "dest": "https://palpitacojb.onrender.com/health"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://palpitacojb.onrender.com/api/$1"
    },

    {
      "handle": "filesystem"
    },

    {
      "src": "^/palpitacomilharprime/(.*)$",
      "dest": "/palpitacomilharprime/index.html"
    },

    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
