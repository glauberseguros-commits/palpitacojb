rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================================================
       HELPERS
    ========================================================= */

    function signedIn() {
      return request.auth != null;
    }

    // Admin = existe doc /admins/{uid} e active == true
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * ✅ Campos permitidos para o PRÓPRIO usuário (client)
     * - inclui variações antigas para compatibilidade
     */
    /*
     * PERFIL DO USUARIO
     *
     * Assinatura comercial nao pertence a users/{uid}.
     * Trial nao existe.
     * O client pode criar/alterar somente identidade e perfil.
     */

    function userCreateIsSafe() {
      return
        request.resource.data.keys().hasOnly([
          "email",
          "createdAt",
          "createdAtMs",
          "updatedAt",
          "updatedAtMs",
          "lastActiveAt",
          "name",
          "phoneDigits",
          "phone",
          "photoUrl",
          "photoURL"
        ])

        && (
          !("email" in request.resource.data)
          || request.resource.data.email == request.auth.token.email
        );
    }

    function userUpdateIsSafe() {
      return
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "email",
            "updatedAt",
            "updatedAtMs",
            "lastActiveAt",
            "name",
            "phoneDigits",
            "phone",
            "photoUrl",
            "photoURL"
          ])

        && (
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(["email"])
          || request.resource.data.email == request.auth.token.email
        );
    }
    /* =========================================================
       ADMINS
    ========================================================= */

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false; // somente via Console (por enquanto)
    }

    /* =========================================================
       USERS
       - perfil do usuario;
       - nenhuma autoridade comercial no client.
    ========================================================= */

    match /users/{uid} {
      allow get:
        if isOwner(uid) || isAdmin();

      allow list:
        if isAdmin();

      allow create:
        if (
          isOwner(uid) &&
          userCreateIsSafe()
        ) || isAdmin();

      allow update:
        if (
          isOwner(uid) &&
          userUpdateIsSafe()
        ) || isAdmin();

      allow delete:
        if isAdmin();
    }
    /* =========================================================
       DADOS DO APP (PREVIEW PUBLIC READ)
       - Para o modo "Entrar sem login (Preview)" funcionar,
         precisamos permitir READ sem auth.
       - WRITE continua restrito a admin.
    ========================================================= */

    match /draws/{drawId} {
      allow read: if true;        // ✅ público (Preview funciona)
      allow write: if isAdmin();
    }

    match /draws/{drawId}/prizes/{prizeId} {
      allow read: if true;        // ✅ público (Preview funciona)
      allow write: if isAdmin();
    }

    /* =========================================================
       HISTÓRICO GLOBAL DO TOP3
       - leitura pública;
       - criação somente por usuário autenticado;
       - snapshot original imutável;
       - atualização limitada à validação do resultado.
    ========================================================= */

    match /top3_predictions/{predictionId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.predictionType == "TOP3"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "predicted"
        && request.resource.data.targetYmd is string
        && request.resource.data.targetHour is string
        && request.resource.data.lotteryKey is string
        && request.resource.data.snapshot is list
        && request.resource.data.snapshot.size() > 0
        && request.resource.data.snapshot.size() <= 3;

      /*
       * TOP3_ENGINE_OUTPUT_FIRST_PUBLISH_FREEZE_V1
       *
       * A primeira previsao criada para este slot e imutavel.
       *
       * UPDATE existe exclusivamente para validacao
       * do resultado oficial.
       */
      allow update: if
        signedIn()

        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "resultGrupo",
          "resultMilhar",
          "resultAnimal",
          "hitType",
          "hitScore",
          "hitPosition",
          "matchedValue",
          "validatedAt",
          "validatedBy",
          "updatedAt",
          "status"
        ])

        && request.resource.data.status == "validated"
        && request.resource.data.validatedBy == request.auth.uid;

      allow delete: if false;
    }

    /* =========================================================
       TERNO DE GRUPO
       - domínio de persistência independente do TOP3;
       - leitura pública;
       - primeira previsão do slot imutável;
       - update exclusivamente para validação do resultado.
    ========================================================= */

    match /terno_grupo_predictions/{predictionId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.predictionType == "TERNO_GRUPO"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "predicted"
        && request.resource.data.targetYmd is string
        && request.resource.data.targetHour is string
        && request.resource.data.lotteryKey is string
        && request.resource.data.snapshot is list
        && request.resource.data.snapshot.size() > 0
        && request.resource.data.snapshot.size() <= 3;

      allow update: if
        signedIn()

        && resource.data.predictionType == "TERNO_GRUPO"

        && request.resource.data.predictionType ==
          resource.data.predictionType

        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "resultGrupo",
          "resultMilhar",
          "resultLotteryKey",
          "resultAnimal",
          "resultTop3Groups",
          "resultTop3Milhares",
          "hitType",
          "hitScore",
          "hitPosition",
          "predictionPosition",
          "resultPosition",
          "podiumMedal",
          "matchedGrupo",
          "matchedMilhar",
          "matchedAnimal",
          "matchedValue",
          "validatedAt",
          "validatedBy",
          "updatedAt",
          "status"
        ])

        && request.resource.data.status == "validated"
        && request.resource.data.validatedBy == request.auth.uid;

      allow delete: if false;
    }

    /* =========================================================
       DEFAULT: FECHA TUDO
    ========================================================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
